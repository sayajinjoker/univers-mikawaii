{
  "name": "univers-mikawaii",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "reconcile:stripe": "node ./scripts/reconcile-stripe-fulfillment.mjs",
    "reconcile:backfill": "node ./scripts/backfill-fulfilled-metadata.mjs",
    "reconcile:cron:local": "powershell -NoProfile -Command \"Invoke-WebRequest -UseBasicParsing -Uri 'http://localhost:3000/api/cron/reconcile?hours=24' -Headers @{ Authorization = 'Bearer ' + $env:CRON_SECRET } | Select-Object -ExpandProperty Content\"",
    "smoke:security": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/local-security-smoke.ps1"
  },
  "dependencies": {
    "build": "^0.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "next": "^16.2.12",
    "npm": "^11.21.1",
    "pdfkit": "^0.21.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "run": "^2.1.11",
    "shadcn": "^4.15.0",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.1.1",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  }
